{
  "name": "whisperai-sdk",
  "version": "2.1.0",
  "description": "TypeScript SDK for WhisperAI: methods and interfaces for interacting with the service without external runtime dependencies.",
  "keywords": [
    "whisper",
    "speech-to-text",
    "transcription",
    "typescript",
    "sdk"
  ],
  "homepage": "https://whisperai.com/",
  "bugs": {
    "url": "https://github.com/iHaiduk/whisperai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iHaiduk/whisperai.git"
  },
  "license": "MIT",
  "author": "Igor Haiduk",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt",
    "README.md"
  ],
  "scripts": {
    "build": "bun run clean && bun build ./src/index.ts --outdir ./dist --target=node --format=esm && tsc --emitDeclarationOnly",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "release": "semantic-release"
  },
  "dependencies": {},
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "module": "./dist/index.js"
}
